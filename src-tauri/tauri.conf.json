{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purple Capture",
  "version": "1.0.1",
  "identifier": "com.purplecapture.desktop",
  "build": {
    "frontendDist": "../build/frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Purple Capture",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 850,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "share-preview"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; media-src 'self' blob:; style-src 'self'; script-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
